        </mxCell>
        <mxCell id="l1" value="Idea / not started" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="150" height="30" as="geometry"/>
